# ==============================================================================
# CarePill Environment Configuration Template
# Copy this file to .env in backend/ or root to configure local overrides.
# NOTE: Simulated provider is enabled by default for safe local development.
# ==============================================================================

# Database
DATABASE_URL=sqlite:///./pillbox.db

# Notification Provider Selection: "simulated", "twilio", or "webhook"
NOTIFICATION_PROVIDER=simulated

# ------------------------------------------------------------------------------
# Twilio Integration (for SMS & WhatsApp)
# Required only if NOTIFICATION_PROVIDER=twilio
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# For Standard SMS:
TWILIO_FROM_NUMBER=+15551234567

# For WhatsApp:
# Use your Twilio WhatsApp Sandbox number (e.g., whatsapp:+14155238886)
# or your approved WhatsApp Business Sender number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: Twilio Content Template SID for approved WhatsApp templates
TWILIO_WHATSAPP_TEMPLATE_SID=

# ------------------------------------------------------------------------------
# Webhook Provider (e.g. Zapier, Make, Slack, or Hospital EHR Webhook)
# Required only if NOTIFICATION_PROVIDER=webhook
# ------------------------------------------------------------------------------
WEBHOOK_URL=https://example.com/api/carepill-alerts
